{
  "info": {
    "name": "GoRest API - Lab 05 YC2",
    "_postman_id": "f5b8c504-2cb4-4094-9132-ae7afa6240f1",
    "description": "7 requests, 3 CSV iterations; token via GitHub Secrets. Run complete collection with users.csv.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "01 POST User - Data Driven",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CSV row is available\",()=>{[\"name\",\"gender\",\"email\",\"status\"].forEach(k=>pm.expect(pm.iterationData.get(k),k).to.exist);});",
                  "const originalEmail=pm.iterationData.get(\"email\");",
                  "pm.variables.set(\"email\",originalEmail.replace(\"{{RUN_ID}}\",String(Date.now())+\"-\"+pm.info.iteration));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST returns 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const u=pm.response.json(); pm.environment.set(\"userId\",String(u.id)); pm.environment.set(\"createdEmail\",u.email); pm.test(\"Created user matches CSV\",()=>{pm.expect(u.email).to.eql(pm.variables.get(\"email\"));pm.expect(u.name).to.eql(pm.iterationData.get(\"name\"));}); }"
                ]
              }
            }
          ],
          "id": "b6776ff5-68f1-40d7-ae61-aaac6e7496ec"
        },
        {
          "name": "02 GET User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET returns 200\",()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){pm.test(\"User ID matches\",()=>pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get(\"userId\")));}"
                ]
              }
            }
          ],
          "id": "89a7fe69-e79b-4000-a88f-daad3e828ee2"
        },
        {
          "name": "03 PATCH User - inactive",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"inactive\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PATCH returns 200\",()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){pm.test(\"Status changed to inactive\",()=>pm.expect(pm.response.json().status).to.eql(\"inactive\"));}"
                ]
              }
            }
          ],
          "id": "0e43209d-14d8-421b-9522-36debc2bbed7"
        },
        {
          "name": "04 DELETE User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"DELETE returns 204\",()=>pm.response.to.have.status(204));",
                  "pm.test(\"DELETE response has no content\",()=>pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ],
          "id": "b913fa89-9c53-4d98-9410-1435392799d3"
        }
      ]
    },
    {
      "name": "Negative_Cases",
      "item": [
        {
          "name": "05 POST User - No Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No token returns 401\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "id": "766230fe-7a2e-4e8c-88fd-ba730d026c89"
        },
        {
          "name": "06 POST User - Duplicate Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Duplicate Test\", \"gender\": \"male\", \"email\": \"{{duplicateEmail}}\", \"status\": \"active\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = \"duplicate-\" + Date.now() + \"-\" + pm.info.iteration + \"@example.com\";",
                  "pm.variables.set(\"duplicateEmail\",email);",
                  "pm.sendRequest({url:pm.environment.get(\"baseUrl\")+\"/users\",method:\"POST\",header:{Authorization:\"Bearer \"+pm.environment.get(\"token\"),\"Content-Type\":\"application/json\"},body:{mode:\"raw\",raw:JSON.stringify({name:\"Duplicate Fixture\",gender:\"male\",email:email,status:\"active\"})}},(err,res)=>{",
                  "  if(err || !res || res.code!==201){throw new Error(\"Could not create duplicate fixture: \"+(err||res.code));}",
                  "  pm.environment.set(\"duplicateFixtureId\",String(res.json().id));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate email returns 422\",()=>pm.response.to.have.status(422));",
                  "if(pm.response.code===422){pm.test(\"Email validation error\",()=>pm.expect(JSON.stringify(pm.response.json()).toLowerCase()).to.include(\"email\"));}",
                  "const fixtureId=pm.environment.get(\"duplicateFixtureId\");",
                  "if(fixtureId){pm.sendRequest({url:pm.environment.get(\"baseUrl\")+\"/users/\"+fixtureId,method:\"DELETE\",header:{Authorization:\"Bearer \"+pm.environment.get(\"token\")}},(err,res)=>{pm.test(\"Duplicate fixture cleanup\",()=>{pm.expect(err).to.equal(null);pm.expect(res.code).to.eql(204);});});pm.environment.unset(\"duplicateFixtureId\");}"
                ]
              }
            }
          ],
          "id": "688183ff-f6ce-4918-8844-d185c0ac1961"
        },
        {
          "name": "07 GET User - After DELETE",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted user returns 404\",()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "id": "63784bf4-23b7-4ca5-af03-2c529848d0d1"
        }
      ]
    },
    {
      "name": "Production_Monitor",
      "item": [
        {
          "name": "GET Users - Monitor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is below 800ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users",
            "description": "Production monitor: GET users, HTTP 200, response < 800ms."
          },
          "response": []
        }
      ]
    }
  ]
