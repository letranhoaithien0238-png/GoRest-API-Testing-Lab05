{
  "info": {
    "_postman_id": "acb2a707-16d5-40aa-bb76-b23cde9ebacf",
    "name": "2373401010431_LeTraHoaiThien_GoRest",
    "description": "GoRest Lab 05: run entire collection with users.csv (3 iterations). Script-controlled flow POST > GET > PATCH > duplicate email > DELETE > GET deleted > no token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59100164",
    "_collection_link": "https://go.postman.co/collection/59100164-acb2a707-16d5-40aa-bb76-b23cde9ebacf?source=collection_link"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "01_POST_User_DataDriven",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.iterationData;",
                  "const required = [\"name\", \"gender\", \"email\", \"status\"];",
                  "required.forEach(k => { if (!row.get(k)) throw new Error(\"Missing CSV column/value: \" + k); });",
                  "const originalEmail = String(row.get(\"email\"));",
                  "const at = originalEmail.lastIndexOf(\"@\");",
                  "if (at < 1) throw new Error(\"Invalid CSV email\");",
                  "const runId = pm.collectionVariables.get(\"runId\") || String(Date.now());",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "const uniqueEmail = originalEmail.slice(0, at) + \".\" + runId + \".\" + pm.info.iteration + originalEmail.slice(at);",
                  "[\"name\",\"gender\",\"status\"].forEach(k => pm.variables.set(k, row.get(k)));",
                  "pm.variables.set(\"email\", uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  " const u=pm.response.json();",
                  " pm.test(\"User ID returned\",()=>pm.expect(u.id).to.be.a(\"number\"));",
                  " pm.test(\"Name and email match\",()=>{",
                  "  pm.expect(u.name).to.eql(pm.variables.get(\"name\"));",
                  "  pm.expect(u.email).to.eql(pm.variables.get(\"email\"));",
                  " });",
                  " pm.environment.set(\"userId\", String(u.id));",
                  " pm.environment.set(\"userEmail\", u.email);",
                  " pm.environment.set(\"userName\", u.name);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02_GET_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.test(\"Correct user ID\",()=>pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get(\"userId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03_PATCH_User_Inactive",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.test(\"Inactive status\",()=>pm.expect(pm.response.json().status).to.eql(\"inactive\"));",
                  "if (pm.response.code === 200) pm.execution.setNextRequest(\"post-duplicate\");"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"inactive\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "04_DELETE_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "",
                  "if (pm.response.code === 204) pm.execution.setNextRequest(\"get-deleted\");"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
