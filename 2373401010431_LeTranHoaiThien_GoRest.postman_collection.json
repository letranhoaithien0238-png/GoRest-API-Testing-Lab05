            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Cập nhật User thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Trạng thái User đã chuyển thành inactive\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.status).to.eql(\"inactive\");\r\n});\r\n\r\npm.test(\"ID User không thay đổi sau khi cập nhật\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedId = pm.environment.get(\"userid\");\r\n\r\n    pm.expect(jsonData.id).to.eql(Number(expectedId));\r\n});\r\n"
                ]
