  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\n\r\n\r\n\r\n\r\npm.test(\"POST User - Status 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.test(\"Tên User khớp dữ liệu CSV\", function () {\r\n        pm.expect(jsonData.name).to.eql(\r\n            pm.iterationData.get(\"name\")\r\n        );\r\n    });\r\n\r\n    pm.test(\"Email khớp dữ liệu CSV\", function () {\r\n        pm.expect(jsonData.email).to.eql(\r\n            pm.iterationData.get(\"email\")\r\n        );\r\n    });\r\n\r\n    pm.test(\"Status User là active\", function () {\r\n        pm.expect(jsonData.status).to.eql(\"active\");\r\n    });\r\n\r\n    // Lưu ID User\r\n    pm.environment.set(\"userid\", jsonData.id);\r\n\r\n    // Lưu Email để kiểm thử trùng Email\r\n    pm.environment.set(\"createdEmail\", jsonData.email);\r\n}\r\n"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\n{\n    \"name\": \"Le Tran Hoai Thien\",\n    \"gender\": \"male\",\n    \"email\": \"thien.gorest.202613024.937467182@example.com\",\n    \"status\": \"active\"\n}\n\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASEURL}}/users",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Lấy thông tin User thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"ID User khớp với User vừa tạo\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedId = pm.environment.get(\"userid\");\r\n\r\n    pm.expect(jsonData.id).to.eql(Number(expectedId));\r\n});\r\n\r\npm.test(\"Thông tin User được trả về đầy đủ\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.have.property(\"name\");\r\n    pm.expect(jsonData).to.have.property(\"email\");\r\n    pm.expect(jsonData).to.have.property(\"gender\");\r\n    pm.expect(jsonData).to.have.property(\"status\");\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASEURL}}/users/{{userid}}",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users",
                "{{userid}}"
              ]
            }
          },
          "response": []
