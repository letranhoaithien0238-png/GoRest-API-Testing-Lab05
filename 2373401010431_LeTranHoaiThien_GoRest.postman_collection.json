              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Từ chối tạo User trùng Email (Status 422)\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\npm.test(\"Hệ thống thông báo Email đã tồn tại\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.be.an(\"array\");\r\n\r\n    var emailError = jsonData.find(function (item) {\r\n        return item.field === \"email\";\r\n    });\r\n\r\n    pm.expect(emailError).to.exist;\r\n    pm.expect(emailError.message).to.include(\"has already been taken\");\r\n});\r\n"
