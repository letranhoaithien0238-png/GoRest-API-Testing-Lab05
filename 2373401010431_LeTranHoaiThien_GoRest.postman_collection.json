              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST Duplicate Email - Status 422\", () => pm.response.to.have.status(422));",
                  "if (pm.response.code === 422) {",
                  " const errors=pm.response.json();",
                  " pm.test(\"Email đã tồn tại\", () => pm.expect(errors.some(x=>x.field===\"email\" && x.message===\"has already been taken\")).to.be.true);",
                  "}",
                  "pm.execution.setNextRequest(\"04 - DELETE User\");"
                ]
