              "raw": "{{BASEURL}}/users",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Monitor - Status 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Monitor - response under 800ms',()=>pm.expect(pm.response.responseTime).to.be.below(800));",
                  "if(pm.response.code===200){pm.test('Monitor - JSON array',()=>pm.expect(pm.response.json()).to.be.an('array'));}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
