{
  "info": {
    "name": "2373401010431_LeTranHoaiThien_GoRest",
    "_postman_id": "9cda8f38-97f5-4bd3-8c6d-f21362d7517c",
    "description": "Lab 05 GoRest - 7 requests, CSV Data Driven, chaining and CI/CD. Chạy toàn bộ Collection (không chạy riêng folder) để điều hướng Duplicate trước DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "01 - POST User - Data Driven",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.iterationData;",
                  "const originalEmail = data.get(\"email\") || \"thien.lab05@example.com\";",
                  "const parts = originalEmail.split(\"@\");",
                  "if (parts.length !== 2) throw new Error(\"CSV email không hợp lệ\");",
                  "const uniqueEmail = parts[0] + \".\" + Date.now() + \".\" + Math.floor(Math.random()*1000000000) + \"@\" + parts[1];",
                  "pm.variables.set(\"runName\", data.get(\"name\") || \"Le Tran Hoai Thien\");",
                  "pm.variables.set(\"runGender\", data.get(\"gender\") || \"male\");",
                  "pm.variables.set(\"runStatus\", data.get(\"status\") || \"active\");",
                  "pm.variables.set(\"runEmail\", uniqueEmail);",
                  "pm.environment.unset(\"userid\");",
                  "pm.environment.unset(\"createdEmail\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST User - Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const user = pm.response.json();",
                  "  pm.test(\"Tên đúng dữ liệu CSV\", () => pm.expect(user.name).to.eql(pm.variables.get(\"runName\")));",
                  "  pm.test(\"Giới tính đúng dữ liệu CSV\", () => pm.expect(user.gender).to.eql(pm.variables.get(\"runGender\")));",
                  "  pm.test(\"Email tạo mới đúng\", () => pm.expect(user.email).to.eql(pm.variables.get(\"runEmail\")));",
                  "  pm.test(\"Trạng thái đúng dữ liệu CSV\", () => pm.expect(user.status).to.eql(pm.variables.get(\"runStatus\")));",
                  "  pm.test(\"User có ID\", () => pm.expect(user.id).to.be.a(\"number\"));",
                  "  pm.environment.set(\"userid\", String(user.id));",
                  "  pm.environment.set(\"createdEmail\", user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASEURL}}/users",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{runName}}\",\n  \"gender\": \"{{runGender}}\",\n  \"email\": \"{{runEmail}}\",\n  \"status\": \"{{runStatus}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "02 - GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET User - Status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const u=pm.response.json();",
                  " pm.test(\"ID đúng User vừa tạo\", () => pm.expect(String(u.id)).to.eql(pm.environment.get(\"userid\")));",
                  " pm.test(\"Email đúng User vừa tạo\", () => pm.expect(u.email).to.eql(pm.environment.get(\"createdEmail\")));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASEURL}}/users/{{userid}}",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users",
                "{{userid}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - PATCH User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PATCH User - Status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " pm.test(\"User chuyển inactive\", () => pm.expect(pm.response.json().status).to.eql(\"inactive\"));",
                  "}",
                  "pm.execution.setNextRequest(\"06 - POST User - Duplicate Email\");"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
