  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": []
    },
    {
      "name": "Negative_Cases",
      "item": []
    },
    {
      "name": "Monitor_Cases",
      "description": "Chạy độc lập cho Yêu cầu 4, GET users và kiểm tra thời gian phản hồi dưới 800ms.",
      "item": [
        {
          "name": "Monitor - GET Users - 200 and under 800ms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASEURL}}/users",
              "host": [
                "{{BASEURL}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Monitor GoRest GET /users; không yêu cầu token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Monitor - Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Monitor - Response time < 800ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);",
                  "});",
                  "pm.test(\"Monitor - Response body is a JSON array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}